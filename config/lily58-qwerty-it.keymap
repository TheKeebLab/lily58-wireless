// QWERTY (Italian) layout for the lily58, generated from the stock keymap.
// Layer 0 keys stay where they are (the computer's keyboard language decides what they type);
// the other layers type the same characters as the stock keymap. Extra keys:
//   layer 2, key 1: ù
//   layer 2, key 2: ì
//   layer 2, key 3: €
// Not on this layout, key left empty: layer 1, key 24 (`)
// Not on this layout, key left empty: layer 1, key 35 (~)
// Not on this layout, key left empty: layer 2, key 12 (`)
/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

// Wake-up key: top outer corner (Esc / `), row pin 5, column pin 19 on both halves.
#define TKL_WAKE_ROW 5
#define TKL_WAKE_COL 19
// Switch-off: Esc + left Shift held together.
#define TKL_OFF_KEYS 0 36
#include "tkl_power.dtsi"
#include "tkl_brightness.dtsi"

// Our Lily58 has no rotary encoder: disable the optional one that the ZMK lily58
// shield turns on. It lives here because ZMK reads the keymap after
// the shield files; a config .overlay is read before them and can't reach the node.
&left_encoder {
    status = "disabled";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Y  &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                      &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &kp LGUI &mo 1  &kp SPACE  &kp RET  &mo 2  &kp BSPC &kp RGUI
            >;
        };

        lower_layer {
            bindings = <
&bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4                 &out OUT_USB &out OUT_BLE &scr_bri &trans  &trans    &trans
&kp F1     &kp F2           &kp F3            &kp F4            &kp F5       &kp F6                       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&none      &kp EXCL         &kp RA(SEMI)            &kp RA(SQT)          &kp DOLLAR   &kp PRCNT                    &kp LS(EQUAL) &kp LS(N6)  &kp LS(RBKT) &kp LS(N8)  &kp LS(N9)  &none
&trans     &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans       &trans    &trans   &trans    &trans    &kp FSLH  &kp RBKT  &kp LS(RA(LBKT))  &kp LS(RA(RBKT))  &kp LS(GRAVE)
                                              &trans            &trans       &trans    &trans   &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
            bindings = <
&trans    &kp NON_US_HASH &kp EQUAL &kp RA(E)  &trans  &trans                       &trans      &trans    &trans    &trans   &trans    &trans
&none     &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6      &kp N7    &kp N8    &kp N9   &kp N0    &trans
&kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &trans      &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &trans
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &trans   &trans    &kp KP_PLUS &kp FSLH  &kp LS(N0) &kp RA(LBKT) &kp RA(RBKT)  &kp GRAVE
                        &trans  &trans  &trans    &trans   &trans    &trans      &trans    &trans
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };
    };
};
